{
  "version": 2,
  "rewrites": [
    {
      "source": "/stream/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/watch/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/dl/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

